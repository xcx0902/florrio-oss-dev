# Editor defaults for every hand-written product file. The formatter entry
# points enforce the same rules; this file only keeps editors consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown prose is wrapped by its author, not by the editor.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
