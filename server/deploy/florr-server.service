[Unit]
Description=Florr.io authoritative multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=florr
Group=florr
WorkingDirectory=/opt/florr
ExecStart=/opt/florr/server/florr_server --config /etc/florr/server.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/florr
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
