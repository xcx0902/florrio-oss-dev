  "changelog": [
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "New petals."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "We're back to FFA."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        3,
        1,
        1,
        2,
        1
      ],
      "text": [
        [
          "Changed value from last change to 2.5 seconds."
        ],
        [
          "Leaf, Cactus and Faster now only apply their effects once they",
          "have spawned the first time.",
          "Effect still applies if they're reloading after they get destroyed."
        ],
        [
          "We'll be playing Battle Royale again for the next couple of days."
        ],
        [
          "Battle Royale now has 3x exp and drop rate."
        ],
        [
          "The game mode will be polished a bit better later, for now it's a",
          "bit of a work in progress."
        ],
        [
          "Buffed Epic Peas a little bit."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2
      ],
      "text": [
        [
          "First petal spawn when changing a slot takes at least 5 seconds.",
          "Which makes quickly swapping loadouts less effective."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "You can now press X to swap your loadout."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1
      ],
      "text": [
        [
          "Nerfed Leaf damage by 20%."
        ],
        [
          "Reduced Stinger health."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2
      ],
      "text": [
        [
          "It seems there aren't enough players to support the game mode.",
          "We've switched back to FFA now."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        4
      ],
      "text": [
        [
          "We'll be trying out a new game mode for a couple of days: Battle",
          "Royale.",
          "There aren't enough players to split among two game modes, so",
          "this will be the only game mode available for a little bit."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "Added 1 new petal."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "Honey now also slows down movement speed a little bit."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "Added 1 new petal."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1
      ],
      "text": [
        [
          "Flowers now only keep up to 10 items after their death."
        ],
        [
          "Flowers now spawn at 3/4 their previous level, rather than half."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2
      ],
      "text": [
        [
          "You now get to keep some of your items and half your level when",
          "you die."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1,
        1
      ],
      "text": [
        [
          "Changed flower health from 100-200 (lvl 1-45) to 100-150."
        ],
        [
          "Rarer drops take a tiny bit longer to despawn."
        ],
        [
          "Legendary Egg hatch time nerfed."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1
      ],
      "text": [
        [
          "Added 1 new petal."
        ],
        [
          "Web now affects mobs."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2,
        1
      ],
      "text": [
        [
          "Turns out Hornets got too smart. Now only a small percentage of",
          "them will be einstein."
        ],
        [
          "Web movement speed debuff increased."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1
      ],
      "text": [
        [
          "Hornet AI is now a lot smarter. No more herding."
        ],
        [
          "Nerfed Hornet missile damage."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "Added 1 new petal."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        3
      ],
      "text": [
        [
          "Unknown zone is now a lot smaller.",
          "All other zones are the same size as before, which means the map",
          "got smaller."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1
      ],
      "text": [
        [
          "Added spiders."
        ],
        [
          "Added 3 new petals."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2,
        1,
        1,
        2,
        2
      ],
      "text": [
        [
          "Legendary petals are now easier to find.",
          "Square has been moved to a separate category."
        ],
        [
          "Rare Roses now stick together."
        ],
        [
          "Added 1 new petal."
        ],
        [
          "Changed map dimensions (total area still the same, just longer",
          "sideways)."
        ],
        [
          "All flowers are now the same speed, regardless of level.",
          "Mob chase speed adjusted to compensate."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        2
      ],
      "text": [
        [
          "Rare Rose nerfed (-30% heal)."
        ],
        [
          "Dandelion rarity changed to Rare (now drops a lot more",
          "frequently)."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        2,
        1
      ],
      "text": [
        [
          "Added Ladybug variant to ???."
        ],
        [
          "Hornets were accidentally made a lot more common a couple of",
          "days ago, that has been fixed."
        ],
        [
          "Added 1 new petal."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        3,
        1
      ],
      "text": [
        [
          "Petal drop rates are now generated automatically.",
          "This will allow a more fair distribution of drops based on their",
          "rarity (so for example, all epics are equally as rare)."
        ],
        [
          "Mobs can now drop more than one petal at a time."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2
      ],
      "text": [
        [
          "Added keyboard controls (disabled by default until we know",
          "which players prefer)."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1
      ],
      "text": [
        [
          "Added Egg petal."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        1,
        1,
        1,
        1
      ],
      "text": [
        [
          "Improved changelog UI."
        ],
        [
          "Added Discord button. Join our community!"
        ],
        [
          "Reddit button soon, meanwhile, join us at reddit.com/r/florrio"
        ],
        [
          "Mob gallery improvements."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
        2,
        1,
        2
      ],
      "text": [
        [
          "Added mob gallery. No pictures at the moment, but maybe",
          "eventually."
        ],
        [
          "Added 2 new petals."
        ],
        [
          "Decreased ram damage between two low leveled flowers (to curb",
          "noobs chasing each other)."
        ]
      ]
    },
    {
      "wrap": 433.239990234375,
      "lines": [
