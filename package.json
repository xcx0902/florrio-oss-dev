{
  "name": "florrio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:dist-next",
    "setup:format": "node tools/setup-format-tools.mjs",
    "format": "node tools/format.mjs",
    "format:check": "node tools/format.mjs --check",
    "lint": "eslint --max-warnings=0 .",
    "check:refactor": "node tools/check-refactor.mjs",
    "start": "node serve.mjs --root dist-next",
    "build:engine": "cmake -S engine -B build/engine -DCMAKE_BUILD_TYPE=Release && cmake --build build/engine -j 6",
    "build:engine:wasm": "node tools/build-engine-wasm.mjs",
    "build:client": "node tools/build-client.mjs",
    "build:dist-next": "node tools/build-dist-next.mjs",
    "verify:dist-next": "node tools/verify-dist-next.mjs",
    "schema:generate": "node tools/generate.mjs",
    "test": "npm run test:unit && npm run test:tools",
    "test:unit": "node tools/run-tests.mjs unit",
    "test:tools": "node tools/run-tests.mjs tools",
    "test:engine": "npm run build:engine && node tools/run-tests.mjs engine",
    "test:client": "npm run build:client && node tools/run-tests.mjs client",
    "test:delivery": "CLIENT_ROOT=dist-next node tools/run-tests.mjs delivery",
    "test:all": "node tools/run-verification.mjs",
    "test:m4": "node tools/performance/verify.mjs",
    "test:light": "npm run format:check && npm run lint && npm run check:refactor && npm run test:unit && npm run test:tools && npm run test:engine && npm run build:engine:wasm && npm run test:client && npm run build:dist-next -- --skip-build && npm run verify:dist-next",
    "perf:client": "node tools/perf-client.mjs --frames 600",
    "schema:check": "node tools/generate.mjs --check",
    "test:integration": "npm run build:engine && node tools/run-tests.mjs integration",
    "build:engine:clean": "cmake --fresh -S engine -B build/engine -DCMAKE_BUILD_TYPE=Release && cmake --build build/engine -j 6",
    "verify:delivery": "node tools/verify-dist-next.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "perf:engine": "node tools/perf-engine.mjs",
    "perf:integration": "node tools/perf-integration.mjs",
    "test:multiplayer:baseline": "npm run build:engine && node tools/multiplayer-baseline.mjs",
    "build:server": "node tools/build-server.mjs",
    "build:multiplayer": "node tools/build-multiplayer.mjs",
    "verify:multiplayer": "node tools/verify-multiplayer-dist.mjs",
    "start:multiplayer": "node tools/dev-multiplayer.mjs",
    "test:server:native": "npm run build:server && node tools/run-tests.mjs server-native",
    "test:multiplayer": "node tools/run-multiplayer-verification.mjs --profile functional",
    "test:multiplayer:all": "npm run perf:multiplayer && node tools/run-multiplayer-verification.mjs --profile all",
    "test:multiplayer:browser": "node tools/multiplayer-browser.mjs",
    "test:multiplayer:deploy": "node tools/deploy-smoke.mjs",
    "perf:multiplayer": "node tools/perf-multiplayer-suite.mjs",
    "pack:native": "node tools/pack-native.mjs",
    "release:multiplayer": "node tools/prepare-multiplayer-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "^1.49.1",
    "prettier": "3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.1",
    "yaml": "^2.6.1"
  }
}
