{
  "name": "legacy-florr-readable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "recover:js": "node tools/recover-javascript.mjs",
    "recover:upstream-js": "node tools/recover-javascript.mjs --upstream",
    "recover:wasm": "node tools/recover-wasm.mjs",
    "build": "node tools/build.mjs --readable --output dist",
    "build:reference": "node tools/build.mjs --output dist-reference",
    "test": "node --test test/*.test.mjs",
    "start": "node serve.mjs --root dist",
    "reference:manifest": "node tools/reference-manifest.mjs",
    "reference:refreeze": "node tools/refreeze-reference.mjs",
    "catalogs:entity-defaults": "node tools/probe-entity-defaults.mjs",
    "catalogs:split": "node tools/split-catalogs.mjs",
    "catalogs:combat": "node tools/derive-petal-combat.mjs",
    "catalogs:drops": "node tools/derive-drop-chances.mjs",
    "catalogs:drops:verify": "node tools/derive-drop-chances.mjs --verify",
    "schema:generate": "node tools/gen-contracts.mjs",
    "schema:probe": "node tools/layout-probe.mjs",
    "parity": "node tools/parity/run-scenario.mjs --all",
    "parity:update": "node tools/parity/run-scenario.mjs --all --update",
    "parity:server": "node tools/parity/server-trace.mjs --all",
    "test:parity": "node tools/parity/run-scenario.mjs --all --repeat 2 && node tools/parity/server-trace.mjs --all",
    "build:engine": "cmake --fresh -S engine -B build/engine -DCMAKE_BUILD_TYPE=Release && cmake --build build/engine -j",
    "test:engine": "npm run build:engine && node tools/run-tap.mjs engine reports/engine-tests.tap -- ./build/engine/engine_tests --tap && ctest --test-dir build/engine --output-on-failure --no-tests=error",
    "build:client": "tsc -p client/tsconfig.json",
    "test:client": "npm run build:client && node tools/run-tap.mjs client reports/client-tests.tap -- node --test --test-reporter=tap client/tests/*.test.mjs",
    "build:engine:wasm": "node tools/build-engine-wasm.mjs",
    "test:reference": "node tools/verify-reference.mjs",
    "test:all": "node tools/run-verification.mjs",
    "test:all:twice": "npm run test:all && npm run test:all",
    "test:light": "npm run test:engine && npm run build:engine:wasm && npm run test:client && npm run test:reference && npm run test:javascript:tap && npm run catalogs:drops:verify && npm run parity:client",
    "parity:client": "node tools/parity/run-client-scenario.mjs --all",
    "build:dist-next": "node tools/build-dist-next.mjs",
    "serve:dist-next": "node serve.mjs --root dist-next",
    "verify:dist-next": "node tools/verify-dist-next.mjs",
    "status:write": "node tools/write-current-verification.mjs",
    "parity:client:update": "node tools/parity/run-client-scenario.mjs --all --update",
    "test:client:parity": "npm run build:client && node tools/parity/run-client-scenario.mjs --all",
    "parity:engine-state": "node tools/parity/server-state-trace.mjs --all --baseline",
    "parity:engine-state:strict": "node tools/parity/server-state-trace.mjs --all --strict",
    "parity:original-engine": "node tools/parity/run-original-engine.mjs",
    "parity:original-engine:all": "node tools/parity/run-original-engine.mjs --all",
    "test:javascript:tap": "node tools/run-tap.mjs javascript reports/javascript-tests.tap -- node --test --test-reporter=tap test/*.test.mjs",
    "perf:client": "node tools/perf-client.mjs --frames 600",
    "gen:client-petals": "node tools/gen-client-petals.mjs",
    "serve:next": "node serve.mjs --next",
    "serve:reference": "node serve.mjs --reference",
    "parity:canvas": "node tools/parity/canvas-command-diff.mjs",
    "parity:visual": "node tools/parity/visual-check.mjs",
    "parity:visual:skip-run": "node tools/parity/visual-check.mjs --skip-run",
    "test:delivery": "CLIENT_ROOT=dist-next node tools/run-tap.mjs delivery reports/delivery-tests.tap -- node --test --test-reporter=tap client/tests/worker-shim.test.mjs client/tests/menu-interactions.test.mjs",
    "parity:hornet": "node tools/parity/hornet-stinger-trace.mjs",
    "parity:canvas:diagnostic": "node tools/parity/canvas-command-diff.mjs --diagnostic",
    "parity:engine-soak:strict": "node tools/parity/server-state-trace.mjs --all --strict --soak-ticks 1000 --out tests/parity/engine-soak",
    "parity:production": "node tools/parity/run-production-scenario.mjs --all",
    "parity:production:delivery": "node tools/parity/run-production-scenario.mjs --root dist-next --all"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "eslint-scope": "9.1.2",
    "playwright-core": "^1.49.1",
    "terser": "5.39.0",
    "typescript": "^5.7.2",
    "wabt": "1.0.39",
    "yaml": "^2.6.1"
  }
}
