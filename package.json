{
  "name": "legacy-florr-rebuild",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:dist-next",
    "start": "node serve.mjs",
    "serve:dist-next": "node serve.mjs --root dist-next",
    "build:engine": "cmake --fresh -S engine -B build/engine -DCMAKE_BUILD_TYPE=Release && cmake --build build/engine -j",
    "build:engine:wasm": "node tools/build-engine-wasm.mjs",
    "build:client": "tsc -p client/tsconfig.json",
    "build:dist-next": "node tools/build-dist-next.mjs",
    "verify:dist-next": "node tools/verify-dist-next.mjs",
    "schema:generate": "node tools/gen-contracts.mjs",
    "gen:client-petals": "node tools/gen-client-petals.mjs",
    "gen:mob-gallery": "node tools/gen-mob-gallery.mjs",
    "gen:menu-content": "node tools/gen-menu-content.mjs",
    "test": "npm run test:unit && npm run test:tools && npm run test:client",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:tools": "node --test tests/tools/*.test.mjs",
    "test:engine": "npm run build:engine && ctest --test-dir build/engine --output-on-failure --no-tests=error",
    "test:client": "npm run build:client && node --test --test-concurrency=1 client/tests/*.test.mjs",
    "test:delivery": "CLIENT_ROOT=dist-next node tools/run-tap.mjs delivery reports/delivery-tests.tap -- node --test --test-concurrency=1 --test-reporter=tap client/tests/worker-shim.test.mjs client/tests/menu-interactions.test.mjs",
    "test:all": "node tools/run-verification.mjs",
    "test:light": "npm run test:unit && npm run test:tools && npm run test:engine && npm run build:engine:wasm && npm run test:client && npm run build:dist-next -- --skip-build && npm run verify:dist-next",
    "perf:client": "node tools/perf-client.mjs --frames 600"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
}
