  "primarySnippets": [
    {
      "sourceId": "primary.changelog",
      "date": "October 20th 2022",
      "text": "October 20th 2022\n\t- Pseudo-RNG system has been removed from crafting. Now it's back to truly random with no increasing odds. If you have any failed attempts on a specific petal, it'll keep using the old system until you succeed (so you don't lose increased odds you already accumulated)."
    },
    {
      "sourceId": "primary.changelog",
      "date": "September 1st 2022",
      "text": "September 1st 2022\n\t- Increased mythic craft chance to 3%."
    },
    {
      "sourceId": "primary.changelog",
      "date": "August 16th 2022",
      "text": "August 16th 2022\n\t- Players can now start on wave 11.\n\t- Mobs can now only drop petals of at most their own rarity.\n\t- Tweaked petal drop rate to compensate.\n\t- Craft chances have been changed.\n\t- Rare rarity color is now a bit more blue."
    },
    {
      "sourceId": "primary.changelog",
      "date": "July 30th 2022",
      "text": "July 30th 2022\n\t- Reduced Lightning petal range.\n\t- Cactus no longer turns poisonous at higher rarity, more health instead."
    },
    {
      "sourceId": "primary.changelog",
      "date": "July 24th 2022",
      "text": "July 24th 2022\n\t- Web no longer stacks, slow increased to -75%."
    },
    {
      "sourceId": "primary.changelog",
      "date": "July 22nd 2022",
      "text": "July 22nd 2022\n\t- Web rarity now affects radius rather than duration."
    },
    {
      "sourceId": "primary.changelog",
      "date": "August 30th 2022",
      "text": "August 30th 2022\n\t- Reworked several mythic petals.\n\t- Leaf can now heal friendly mobs."
    },
    {
      "sourceId": "primary.changelog",
      "date": "August 31st 2022",
      "text": "August 31st 2022\n\t- Peas have been split into Peas and Grapes. Existing Peas have been turned into Grapes."
    }
  ],
