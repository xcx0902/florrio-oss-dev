#pragma once

#include "sim/rules.hpp"

namespace wave::sim::detail {

inline void load_scenario_defaults(Rules& rules) {
  const auto seconds = [&rules](int value) {
    return rules.timing.ticks_ceil(std::chrono::seconds(value));
  };
  rules.version = "@evidence_version@+w1.1";
  rules.remaining_threshold = @threshold@;
  rules.special_chance = @special_chance@;
  rules.special_on_opening_wave = @special_first@;
  rules.advance_on_deadline = @deadline_advances@;
  rules.lifecycle.respawn_next_wave = @next_wave_respawn@;
  rules.waves = {
@waves_cpp@  };
  rules.special_groups = {
@groups_cpp@  };
}

}  // namespace wave::sim::detail
