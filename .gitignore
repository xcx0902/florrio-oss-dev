# Sources only. Everything below is generated locally and must not be
# committed; rebuild it with the product commands when a checkout needs it.

# Editor
.vscode/

# Dependencies and local tool caches
node_modules/
.emcache/

# Delivery and build trees (tools/build-dist-next.mjs, tools/build-engine-wasm.mjs, CMake)
dist-next/
dist-next.lock
dist-next.stage-*/
build/
engine/build-*/

# Compiled client output (tsc outDir + emscripten wasm). The entry page,
# worker shim and fonts are authored sources that live beside the output.
client/public/**/*.js
!client/public/server-worker.js
client/public/**/*.js.map
client/public/**/*.d.ts
client/public/server.wasm
client/public/server.wasm.build.json

# Product acceptance and performance records
reports/*
!reports/.gitkeep

# OS noise
.DS_Store
