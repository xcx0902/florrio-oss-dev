  CHECK(multi_reader.read_u32_le().value() == 5);
  CHECK(multi_reader.read_varint32().value() == 5);
  CHECK(multi_reader.read_f32_le().value() == 1.5F);
  CHECK(multi_reader.read_varint32().value() == 2);
